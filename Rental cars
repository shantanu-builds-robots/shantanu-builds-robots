class Customer:
    def __init__(self, name):
        self.name = name 
        self.rental_history = []
        
    def rent_car(self, brand, model, days, transmission):
          rented_car = Vehicle(brand, model, 2023, 50) 
          rented_car.is_available = False  
          rental_info = { 'car': rented_car,'rental_period': days,'rental_date': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'return_date': None,
            'transmission': transmission}
          self.rental_history.append(rental_info) 
          print (f"{self.name} rented a {brand} {model} ({transmission}) for {days} days.")

    def return_car(self, brand, model):
        for rental in self.rental_history:
            if rental['car'].brand == brand and rental['car'].model == model and rental['return_date'] is None:
                rental['return_date'] = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                rental['car'].is_available = True
                print(f"{self.name} returned the {brand} {model}.")
                return
        print(f"{brand} {model} was not rented or already returned.")

    def view_history(self):
        
        if not self.rental_history:
            print(f"No rental history found for {self.name}.")
        else:
            print(f"Rental History for {self.name}:")
            for rental in self.rental_history:
                car = rental['car']
                print(f"Car: {car.brand} {car.model}, Rented on: {rental['rental_date']}, "
                      f"Rented for: {rental['rental_period']} days, "
                      f"Returned: {rental['return_date'] if rental['return_date'] else 'Not yet returned'}")


    def customer_menu(self):
        print(f"\nWelcome Customer: {self.name}")
        # Customer actions 
        print("Customer Menu:")
        print("1. View Available Cars")
        print("2. Rent Car")
        print("3. Return Car")
        print("4. View History")
        print("5. Logout")
        choice = input("Select option: ")


        if choice == '1':
            print("Ferrari \n BMW \n Porsche \n Lamborghini \n Tesla\n mustang")
        elif choice == '2':
                brand= input("Car to be rented: ")
                model=input ("Which model:  ")
                rate= int(input("time period:   "))
                transmission=input("transmission(Automatic/Manual): ")
                self.rent_car(brand, model,rate, transmission)
        elif choice == '3':
            brand= input("Car to be returned:")
            model= input ("Car Model:")
            self.return_car(brand, model)
        elif choice == '4':
            print("Show history")
            self.view_history()
             
        elif choice == '5':
            print(" Logout Successfull")
        else:
            print("Invalid option")

