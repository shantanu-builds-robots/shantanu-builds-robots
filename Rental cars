# User (Base class for both admin and customer)
class user(  ):
    def __init__(self,username):
        self.username=username

# Admin and Customer (Subclasses of User with role-specific functionality)
# Admin – Can add cars, view all cars, and remove cars from the system
class Admin(user):
    def __init__(self,username, add_cars,view_all_cars,remove_cars):
        super().__init__(username)
        self.add_cars=add_cars
        self.view_all_cars=view_all_cars
        self.remove_cars=remove_cars

 # Customer – Can view available cars, rent a car, return a car, and see rental charges
class Customer(user):
    def __init__(self, available_cars,rent_a_car,return_a_car, rental_charges,username):
        super().__init__(username)
        self.available_cars=available_cars
        self.rent_a_car=rent_a_car
        self.rental_charges=rental_charges

