# Vehicle (Base class for general attributes like brand, model, year, rate)
class Vehicle():
    def __init__(self,brand,model,year,rate):
        self.brand=brand
        self.model=model
        self.year=year
        self.rate=rate

    def add_cars(self):
        self.brand = input("Brand: ")
        self.model = input("Model: ")
        self.year = int(input("Year: "))
        self.rate = float(input("Rate per day: "))
        self.no_of_doors = int(input("Number of doors: "))
        self.transmission = input("Transmission (Automatic/Manual): ")
   
# Car (Derived class from Vehicle, adds number of doors, transmission type)

class Car(Vehicle):
    def __init__(self,no_of_doors,transmission,brand,model,year,rate):
        super().__init__(brand,model,year,rate)
    
        self.no_of_doors=no_of_doors
        self.transmission=transmission
        print(f"This car is a {brand} {model} it has {no_of_doors} doors  and is {transmission}  it costs {rate}per day")

    def check_year(self):
        """
        This Function Checks the
        year of the car to 
        decide if the car is old or new """
        if self.year>2000:
            print ("New car")
        else:
            print("old car")

